# Source for the "How it fits together" diagram on the Tag scanners wiki page.
#
# Render:
#
#   d2 --theme 0 --pad 20 \
#      design/diagrams/tag-scan-flow.d2 design/diagrams/tag-scan-flow.svg
#
# The point the picture has to make is the direction of initiation: the reader
# starts every exchange, and each arrow leaving Spoolman is a reply or a
# broadcast. Spoolman never reaches for hardware. The dashed edge is the reply
# to the POST, which is why it runs backwards up the page.
#
# ---------------------------------------------------------------------------
# How the two-tier boxes are built, and why not the obvious way. All of this is
# measured against d2 v0.7.1; recheck the render if you move versions.
#
# Each box is a CONTAINER whose own label is the title, pulled inside the box
# with `label.near: top-center`, holding one borderless child node that is the
# subtitle. It looks like a hack and it is the only one of four approaches that
# actually works:
#
#   - `|md|` labels give real heading/body hierarchy and are the obvious
#     answer. They are also unusable here: d2 CLIPS md text to a computed box in
#     both dimensions and no `width:`/`height:` will grow the clip region. Every
#     subtitle lost its tail -- "stuck on the spool" rendered as "stuck on the",
#     "which spool has this UID?" as "which spool has this". Silently, with no
#     warning. A `<br/>` makes it worse: the text rewraps narrower and the whole
#     second line disappears. (An md box also drops its stroke and corner radius
#     unless you additionally state `shape: rectangle`.)
#
#     Worth knowing how this hides from you: an md label is emitted as a
#     `<foreignObject>` of HTML, and the browser clips it at render. The full
#     string is still sitting in the SVG, so grepping the file for your text
#     finds it and proves nothing. Either look at the picture, or assert the
#     mechanism is absent:
#
#         grep -c foreignObject design/diagrams/tag-scan-flow.svg   # must be 0
#
#     Plain labels, as used here, emit ordinary <text> and cannot clip this way.
#   - `shape: sql_table` and `shape: class` both measure text correctly, but
#     they render as database/UML furniture: a monospaced dark row, a `+`
#     visibility marker, and the node key showing through as the header.
#   - A plain "\n" label measures correctly and cannot vary size or weight
#     between its lines, so there is no hierarchy to be had.
#
# The container route measures like any normal label, so the subtitles are
# whatever length they need to be.
#
# Deliberately a single theme rather than `--dark-theme`. That flag does work,
# and it bakes a prefers-color-scheme media query into the SVG, but the query
# only survives if whatever embeds the file leaves the internal stylesheet
# intact -- which GitHub's image pipeline is not guaranteed to do. If it were
# stripped, the light theme would win and dark-blue arrows would sit on a
# near-black page. So the canvas is white and every colour is pinned, and the
# picture looks the same wherever it lands.
#
# Layout is vertical because d2 0.7.1 ignores `direction` on a nested container
# (verified: a -> b -> c inside a `direction: right` container still stacks), so
# an L-shape is not reachable without hand-placing nodes.
# ---------------------------------------------------------------------------

direction: down

classes: {
  # The box: a container carrying the title, with the label brought inside.
  node: {
    label.near: top-center
    style: {
      stroke-width: 2
      border-radius: 8
      font-size: 18
      bold: true
      shadow: true
    }
  }
  # A box with nothing to add underneath its title. Same look, but a plain node
  # rather than a container, which is a third of the height: container padding
  # is not adjustable (`height:` is rejected outright by dagre and silently
  # ignored by elk), so the only way to spend less of it is to not open one.
  leaf: {
    style: {
      stroke-width: 2
      border-radius: 8
      font-size: 18
      bold: true
      shadow: true
    }
  }
  # The subtitle: a child with no box of its own, so only its text shows.
  sub: {
    style: {
      fill: transparent
      stroke-width: 0
      font-size: 14
      bold: false
    }
  }
  reply: {
    style: {
      stroke-width: 2
      stroke-dash: 4
      font-size: 13
      stroke: "#64748b"
      font-color: "#64748b"
    }
  }
  call: {
    style: {
      stroke-width: 2
      font-size: 13
      stroke: "#64748b"
      font-color: "#64748b"
    }
  }
}

tag: "Tag on the spool" {
  class: leaf
  style: {
    fill: "#fef3c7"
    stroke: "#b45309"
    font-color: "#78350f"
  }
}

reader: Reader {
  class: node
  style: {
    fill: "#dbeafe"
    stroke: "#1d4ed8"
    font-color: "#1e3a8a"
  }
  sub: "ESP32 · phone · Raspberry Pi · Node-RED · Home Assistant" {
    class: sub
    style.font-color: "#1e40af"
  }
}

spoolman: Spoolman {
  class: node
  style: {
    fill: "#dcfce7"
    stroke: "#15803d"
    font-color: "#14532d"
  }
  sub: "which spool has this tag UID?" {
    class: sub
    style.font-color: "#166534"
  }
}

browser: Your browser {
  class: node
  style: {
    fill: "#ede9fe"
    stroke: "#6d28d9"
    font-color: "#4c1d95"
  }
  sub: "paired with the reader, and listening" {
    class: sub
    style.font-color: "#5b21b6"
  }
}

tag -> reader: "tap" {
  class: call
}

reader -> spoolman: "POST /api/v1/tag/scan" {
  class: call
}

spoolman -> reader: "matched_spool_id" {
  class: reply
}

spoolman -> browser: "the scan, over a websocket" {
  class: call
}
